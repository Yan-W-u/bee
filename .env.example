# =============================================
# Bee 环境变量配置
# 复制此文件为 .env 并根据需要修改
# =============================================

# --- LLM Provider 配置（必需）---
# DeepSeek V4 API
LLM_SERVER_URL=https://api.deepseek.com
LLM_SERVER_KEY=sk-your-deepseek-api-key-here
LLM_SERVER_CONFIG_PATH=/opt/bee/conf/deepseek-v4.provider.yml

# OpenAI API（备选）
# LLM_SERVER_URL=https://api.openai.com/v1
# LLM_SERVER_KEY=sk-your-openai-api-key-here
# LLM_SERVER_CONFIG_PATH=/opt/bee/conf/custom-openai.provider.yml

# OpenRouter API（备选）
# LLM_SERVER_URL=https://openrouter.ai/api/v1
# LLM_SERVER_KEY=sk-or-v1-your-openrouter-api-key-here
# LLM_SERVER_CONFIG_PATH=/opt/bee/conf/openrouter.provider.yml

# Ollama 本地部署（备选）
# LLM_SERVER_URL=http://host.docker.internal:11434/v1
# LLM_SERVER_KEY=ollama
# LLM_SERVER_CONFIG_PATH=/opt/bee/conf/ollama-cloud.provider.yml

# --- Docker 配置 ---
# DOCKER_HOST=unix:///var/run/docker.sock

# --- 数据库配置 ---
# DATABASE_URL=postgres://postgres:bee@db:5432/beedb?sslmode=disable

# --- 搜索工具 API Keys ---
# GOOGLE_API_KEY=your-google-api-key
# GOOGLE_CX_KEY=your-google-cx-key
# TAVILY_API_KEY=your-tavily-api-key
# PERPLEXITY_API_KEY=your-perplexity-api-key

# --- Langfuse 可观测性（可选）---
# LANGFUSE_HOST=http://langfuse:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
# LANGFUSE_SECRET_KEY=sk-lf-your-secret-key

# --- 日志配置 ---
# LOG_LEVEL=info
# LOG_FORMAT=json

# --- 服务端口配置 ---
# PORT=8080
# FRONTEND_PORT=3000